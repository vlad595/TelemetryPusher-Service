FROM mcr.Microsoft.com/dotnet/sdk:10.0 AS build
WORKDiR /src

COPY ["TelemetryHubPusherService.csproj", "./"]
RUN dotnet restore "TelemetryHubPusherService.csproj"

COPY . .
RUN dotnet publish "TelemetryHubPusherService.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.Microsoft.com/dotnet/sdk:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "TelemetryHubPusherService.dll"]